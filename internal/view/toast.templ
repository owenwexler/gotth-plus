package view

type ToastKind string

const (
	ToastSuccess ToastKind = "success"
	ToastError   ToastKind = "error"
)

type ToastArgs struct {
	Kind   ToastKind
	Header string
	Body   string
}

func ErrorToast(header string) ToastArgs {
	return ToastArgs{Kind: ToastError, Header: header, Body: "Please try again"}
}

func toastRole(kind ToastKind) string {
	if kind == ToastError {
		return "alert"
	}

	return "status"
}

func SuccessToast(header string, body string) ToastArgs {
	return ToastArgs{Kind: ToastSuccess, Header: header, Body: body}
}

// Toast is meant to be returned out of band: it appends itself to the #toasts container in the layout.
templ Toast(args ToastArgs) {
	<div hx-swap-oob="beforeend:#toasts">
		<div
			x-data="toast"
			x-show="show"
			x-transition.opacity
			@click="show = false"
			role={ toastRole(args.Kind) }
			class={
				"w-72 rounded-lg shadow-lg bg-white border p-3 cursor-pointer",
				templ.KV("border-red-600", args.Kind == ToastError),
				templ.KV("border-black", args.Kind != ToastError),
			}
		>
			<p
				class={
					"font-bold",
					templ.KV("text-red-600", args.Kind == ToastError),
				}
			>
				{ args.Header }
			</p>
			if args.Body != "" {
				<p class="text-sm text-gray-700">{ args.Body }</p>
			}
		</div>
	</div>
}
