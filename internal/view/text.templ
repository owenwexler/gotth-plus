package view

templ Title() {
	<header class="flex max-w-2xl flex-col items-center gap-6 text-center">
		<h1 class="text-7xl font-semibold tracking-tighter sm:text-9xl">GOTTH<span class="text-neutral-400">+</span></h1>
		<p class="max-w-lg text-lg leading-relaxed text-neutral-200 sm:text-xl">Go, Templ, Tailwind and HTMX, ready for production.</p>
		<p class="text-sm leading-relaxed text-neutral-400">Make it yours. Edit <code class="text-neutral-200">internal/view/pages.templ</code> to get started.</p>
		<p class="text-sm leading-relaxed text-neutral-400">Always open-source. <a class="text-sm leading-relaxed text-neutral-400 underline cursor-pointer" href="https://github.com/owenwexler/gotth-plus" target="_blank" rel="noopener noreferrer">Github</a></p>
	</header>
}

templ ErrorText() {
	<h1 class="text-white text-2xl">We are sorry, something went wrong.</h1>
}
