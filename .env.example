# Copy to .env for local development. In production, set these in the platform's environment instead.

# "development" or "production". Production turns on HSTS, Secure cookies, JSON logs and strict
# rate limits, and removes dev-only routes such as POST /seed.
GoEnv=development

Port=3000

# Optional. SQLite database file; defaults to app.db.
DatabasePath=app.db

# Optional. If set, POST /seed (development only) requires the header "X-Admin-Key: <value>".
SeedAdminKey=
